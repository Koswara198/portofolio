---
const { title = "Adi Tata Koswara — Portfolio" } = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Portfolio Adi Tata Koswara — S1 Teknik Informatika, Developer, Data Enthusiast" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg: #080810;
      --bg2: #0f0f1a;
      --bg3: #16162a;
      --accent: #6c63ff;
      --accent2: #a78bfa;
      --accent3: #38bdf8;
      --text: #e2e2f0;
      --muted: #5a5a78;
      --border: #1e1e32;
      --green: #34d399;
      --amber: #fbbf24;
      --pink: #f472b6;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Syne', sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }

    ::selection { background: rgba(108, 99, 255, 0.3); }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }
  </style>
</head>
<body>
  <slot />
</body>
</html>
